{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<YOUR_SERVER>\\SQLEXPRESS;Database=SAMVAD_DMS;User Id=<DB_USER>;Password=<DB_PASSWORD>;TrustServerCertificate=true;"
  },
  "Jwt": {
    "Key": "<YOUR_JWT_SECRET_KEY_MIN_32_CHARACTERS>",
    "Issuer": "SAMVAD.DMS.Api",
    "Audience": "SAMVAD.DMS.Web",
    "ExpiryHours": 1
  },
  "Sms": {
    "Enabled": false,
    "GatewayUrl": "<SMS_GATEWAY_URL>",
    "ApiKey": "<SMS_API_KEY>",
    "SenderId": "SAMVAD"
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "<SMTP_HOST>",
    "SmtpPort": 587,
    "UseSsl": false,
    "UseStartTls": true,
    "SmtpUsername": "<SMTP_USERNAME>",
    "SmtpPassword": "<SMTP_PASSWORD>",
    "FromAddress": "noreply@yourdomain.com",
    "FromName": "SAMVAD DMS"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
