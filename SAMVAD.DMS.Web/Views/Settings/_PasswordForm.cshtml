@model SAMVAD.DMS.Application.DTOs.User.ChangePasswordDto

<form id="settingsPasswordForm" asp-action="ChangePassword" method="post" class="space-y-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-xs text-rose-600"></div>

    <div>
        <label asp-for="CurrentPassword" class="block text-sm font-medium text-slate-700 mb-1">Current Password</label>
        <input asp-for="CurrentPassword" type="password" class="w-full rounded-xl border-slate-300" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="text-xs text-rose-600"></span>
    </div>

    <div>
        <label asp-for="NewPassword" class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
        <input asp-for="NewPassword" type="password" class="w-full rounded-xl border-slate-300" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="text-xs text-rose-600"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-700 mb-1">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" class="w-full rounded-xl border-slate-300" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-600"></span>
    </div>

    <div class="pt-2">
        <button type="submit" class="rounded-lg bg-slate-900 text-white px-3 py-2 text-sm font-semibold">Update Password</button>
    </div>
</form>