@model SAMVAD.DMS.Application.DTOs.User.UpdateProfileDto

<form id="settingsProfileForm" asp-action="UpdateProfile" method="post" class="space-y-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-xs text-rose-600"></div>

    <div>
        <label asp-for="FullName" class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
        <input asp-for="FullName" class="w-full rounded-xl border-slate-300" placeholder="Enter full name" />
        <span asp-validation-for="FullName" class="text-xs text-rose-600"></span>
    </div>

    <div>
        <label asp-for="ContactNumber" class="block text-sm font-medium text-slate-700 mb-1">Contact Number</label>
        <input asp-for="ContactNumber" class="w-full rounded-xl border-slate-300" placeholder="10-digit contact number" />
        <span asp-validation-for="ContactNumber" class="text-xs text-rose-600"></span>
    </div>

    <div class="pt-2">
        <button type="submit" class="rounded-lg bg-orange-600 text-white px-3 py-2 text-sm font-semibold">Save Profile</button>
    </div>
</form>