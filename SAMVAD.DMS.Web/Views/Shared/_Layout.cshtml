<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SAMVAD DMS</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).Trim();
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).Trim();

    string NavItemClass(string controller, string action = "Index")
    {
        var isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        return isActive
            ? "block px-3 py-2 rounded-lg text-sm font-semibold text-orange-700 bg-orange-50 border border-orange-200"
            : "block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100";
    }
}
<body class="samvad-admin-bg">
    <div class="min-h-screen flex flex-col">
        <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6">
            <div class="flex items-center gap-3">
                <button type="button" id="mobileSidebarToggle" class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-100" aria-label="Open menu" aria-controls="adminSidebar" aria-expanded="false">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <a asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3">
                    <span class="h-9 w-9 rounded-lg bg-orange-600 text-white flex items-center justify-center font-bold">S</span>
                    <span class="font-extrabold text-slate-900 tracking-tight">SAMVAD DMS</span>
                </a>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button class="px-3 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100" type="submit">Logout</button>
            </form>
        </header>

        <div id="mobileSidebarOverlay" class="fixed inset-0 z-30 hidden bg-slate-900/45 md:hidden"></div>

        <div class="flex flex-1 min-h-0 relative">
            <aside id="adminSidebar" class="fixed md:static top-0 left-0 z-40 md:z-auto h-full md:h-auto w-64 bg-white border-r border-slate-200 p-4 space-y-2 transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-out">
                <div class="flex items-center justify-between mb-2 md:hidden">
                    <span class="text-sm font-semibold text-slate-700">Menu</span>
                    <button type="button" id="mobileSidebarClose" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-slate-300 text-slate-700 hover:bg-slate-100" aria-label="Close menu">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <a asp-controller="Dashboard" asp-action="Index" class="@NavItemClass("Dashboard") admin-nav-link">Dashboard</a>
                <a asp-controller="Incidents" asp-action="Index" class="@NavItemClass("Incidents") admin-nav-link">All Incidents</a>
                <a asp-controller="Settings" asp-action="Index" class="@NavItemClass("Settings") admin-nav-link">Settings</a>
                <a asp-controller="Districts" asp-action="Index" class="@NavItemClass("Districts") admin-nav-link">Manage Districts</a>
                <a asp-controller="Admins" asp-action="Index" class="@NavItemClass("Admins") admin-nav-link">Manage Admins</a>
            </aside>

            <main class="flex-1 overflow-y-auto p-4 md:p-6">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
