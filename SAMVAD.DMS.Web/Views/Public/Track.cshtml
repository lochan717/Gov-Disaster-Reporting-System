@model SAMVAD.DMS.Application.DTOs.Incident.IncidentTrackingDto
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Track";

    var isOpen = Model?.Status == SAMVAD.DMS.Domain.Enums.IncidentStatus.Open;
    var isInProgress = Model?.Status == SAMVAD.DMS.Domain.Enums.IncidentStatus.InProgress;
    var isClosed = Model?.Status == SAMVAD.DMS.Domain.Enums.IncidentStatus.Closed;

    var openDone = isOpen || isInProgress || isClosed;
    var inProgressDone = isInProgress || isClosed;
    var closedDone = isClosed;
}

<div class="max-w-xl mx-auto p-6">
    <div class="bg-white rounded-2xl border border-slate-200 p-6">
        <h1 class="text-xl font-bold text-slate-900">Incident Status</h1>
        @if (Model is null)
        {
            <p class="text-slate-600 mt-2">Incident not found.</p>
        }
        else
        {
            <p class="mt-2 text-slate-700">ID: @Model.IncidentId</p>
            <p class="text-slate-700">Type: @Model.DisasterType</p>
            <p class="text-slate-700">Status: @Model.Status</p>
            <p class="text-slate-500 text-sm">Updated: @Model.LastUpdatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>

            <div class="mt-5">
                <div class="grid grid-cols-3 gap-2 text-center text-xs font-semibold">
                    <div class="rounded-lg px-2 py-2 @(openDone ? "bg-[#ec5b13] text-white" : "bg-slate-100 text-slate-500")">Open</div>
                    <div class="rounded-lg px-2 py-2 @(inProgressDone ? "bg-[#ec5b13] text-white" : "bg-slate-100 text-slate-500")">In Progress</div>
                    <div class="rounded-lg px-2 py-2 @(closedDone ? "bg-[#ec5b13] text-white" : "bg-slate-100 text-slate-500")">Closed</div>
                </div>
            </div>

            <div class="mt-4 flex items-center justify-between">
                <p class="text-slate-500 text-sm">This page auto-refreshes every 60 seconds.</p>
                <button type="button" id="refreshBtn" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Refresh now</button>
            </div>

            <div class="mt-5 border-t border-slate-200 pt-4 space-y-2">
                <h2 class="text-sm font-semibold text-slate-700">Attachments Bucket</h2>
                @if (!Model.MediaFiles.Any())
                {
                    <p class="text-xs text-slate-500">No media attachments available for this incident.</p>
                }
                else
                {
                    @foreach (var media in Model.MediaFiles)
                    {
                        var isImage = media.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
                        var viewUrl = Url.Action("TrackMedia", "Public", new { trackingToken = Model.TrackingToken, mediaId = media.Id, fileName = media.FileName, contentType = media.ContentType, download = false }) ?? "#";
                        var downloadUrl = Url.Action("TrackMedia", "Public", new { trackingToken = Model.TrackingToken, mediaId = media.Id, fileName = media.FileName, contentType = media.ContentType, download = true }) ?? "#";

                        <div class="rounded-xl border border-slate-200 p-3 bg-slate-50">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <p class="text-xs font-semibold text-slate-800 truncate">@media.FileName</p>
                                    <p class="text-[11px] text-slate-500">@media.MediaType · @media.UploadedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <a class="text-xs font-semibold text-orange-700 hover:underline" href="@viewUrl" target="_blank" rel="noopener noreferrer">View</a>
                                    <a class="text-xs font-semibold text-slate-700 hover:underline" href="@downloadUrl">Download</a>
                                </div>
                            </div>

                            @if (isImage)
                            {
                                <img src="@viewUrl" alt="@media.FileName" class="mt-2 max-h-36 rounded-lg border border-slate-200 object-contain bg-white" />
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/public-track.js" asp-append-version="true"></script>
}