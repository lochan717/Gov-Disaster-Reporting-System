@model SAMVAD.DMS.Shared.Models.PaginatedResult<SAMVAD.DMS.Application.DTOs.District.DistrictListItemDto>

<div id="districtsListMeta" data-page="@Model.Page" data-page-size="@Model.PageSize" data-total-count="@Model.TotalCount" data-total-pages="@Model.TotalPages" data-has-previous="@Model.HasPreviousPage.ToString().ToLowerInvariant()" data-has-next="@Model.HasNextPage.ToString().ToLowerInvariant()"></div>

<div class="space-y-3 md:hidden">
@if (!Model.Items.Any())
{
    <article class="rounded-2xl border border-dashed border-slate-300 p-4 bg-slate-50 text-sm text-slate-500">No districts found for the selected filters.</article>
}
@foreach (var item in Model.Items)
{
    <article class="rounded-2xl border border-slate-200 p-4 bg-white shadow-sm">
        <div class="flex items-start justify-between gap-3">
            <div>
                <h3 class="text-sm font-semibold text-slate-900">@item.Name</h3>
                <p class="text-xs text-slate-500">@item.Code | @item.State</p>
            </div>
            <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-semibold @(item.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600")">
                @(item.IsActive ? "Active" : "Inactive")
            </span>
        </div>

        <div class="mt-4 flex items-center gap-3 text-xs font-semibold">
            <button type="button" class="text-orange-700 hover:underline district-edit-btn" data-district-id="@item.Id">Edit</button>
            <button type="button" class="text-slate-700 hover:underline district-toggle-btn" data-district-id="@item.Id">Toggle</button>
            <button type="button" class="text-rose-700 hover:underline district-delete-btn" data-district-id="@item.Id">Delete</button>
        </div>
    </article>
}
</div>

<div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left">
        <thead>
            <tr class="text-xs uppercase text-slate-500">
                <th class="py-2">District</th>
                <th>Code</th>
                <th>State</th>
                <th>Status</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr class="border-t border-slate-100 text-sm text-slate-700">
                <td class="py-2">@item.Name</td>
                <td>@item.Code</td>
                <td>@item.State</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td class="text-right space-x-2">
                    <button type="button" class="text-xs font-semibold text-orange-700 hover:underline district-edit-btn" data-district-id="@item.Id">Edit</button>
                    <button type="button" class="text-xs font-semibold text-slate-700 hover:underline district-toggle-btn" data-district-id="@item.Id">Toggle</button>
                    <button type="button" class="text-xs font-semibold text-rose-700 hover:underline district-delete-btn" data-district-id="@item.Id">Delete</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>