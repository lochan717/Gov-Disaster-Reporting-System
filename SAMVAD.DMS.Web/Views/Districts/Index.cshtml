@{
    ViewData["Title"] = "Manage Districts";
    var initialDistricts = SAMVAD.DMS.Shared.Models.PaginatedResult<SAMVAD.DMS.Application.DTOs.District.DistrictListItemDto>.Create(Array.Empty<SAMVAD.DMS.Application.DTOs.District.DistrictListItemDto>(), 0, 1, 20);
}

@Html.AntiForgeryToken()

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-slate-900">Manage Districts</h1>
        <button type="button" id="openAddDistrictPaneBtn" class="rounded-lg bg-orange-600 text-white px-3 py-2 text-sm font-semibold">Add District</button>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
        <div class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl p-5">
            <div class="space-y-3 mb-4 border-b border-slate-200 pb-4">
                <div class="grid grid-cols-1 gap-3">
                    <input type="search" id="districtsSearchInput" class="rounded-lg border border-slate-300 px-3 py-2 text-sm" placeholder="Search by district, code, or state" />
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" id="districtsApplyFiltersBtn" class="rounded-lg bg-slate-900 text-white px-3 py-2 text-sm font-semibold">Apply</button>
                    <button type="button" id="districtsResetFiltersBtn" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700">Reset</button>
                </div>
            </div>
            <div id="districtsListHost">
                <partial name="_List" model="initialDistricts" />
            </div>
            <div class="mt-4 flex items-center justify-between gap-2 border-t border-slate-200 pt-4">
                <button type="button" id="districtsPrevPageBtn" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 disabled:opacity-50" disabled>Previous</button>
                <div class="flex items-center gap-2">
                    <label for="districtsPageSize" class="text-xs text-slate-500">Rows</label>
                    <select id="districtsPageSize" class="rounded-lg border border-slate-300 px-2 py-1.5 text-xs">
                        <option value="10">10</option>
                        <option value="20" selected>20</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <p id="districtsPaginationInfo" class="text-xs text-slate-500">Page 1 of 1</p>
                <button type="button" id="districtsNextPageBtn" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 disabled:opacity-50" disabled>Next</button>
            </div>
        </div>
        <div id="districtSidePane" class="bg-white border border-slate-200 rounded-2xl p-5">
            <p class="text-slate-500">Choose an action to manage district details.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/districts.js" asp-append-version="true"></script>
}