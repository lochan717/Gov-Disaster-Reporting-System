@model SAMVAD.DMS.Application.DTOs.Incident.IncidentAdminSubmitDto
@{
    var districtOptions = ViewBag.SubmissionDistrictOptions as IReadOnlyCollection<SAMVAD.DMS.Application.DTOs.Incident.IncidentSubmissionDistrictOptionDto> ?? Array.Empty<SAMVAD.DMS.Application.DTOs.Incident.IncidentSubmissionDistrictOptionDto>();
    var channels = ViewBag.SubmissionChannels as IReadOnlyCollection<string> ?? Array.Empty<string>();
}

<form id="submitIncidentOnBehalfForm" class="space-y-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-xs text-rose-600"></div>

    <div>
        <label asp-for="DistrictId" class="block text-sm font-medium text-slate-700 mb-1">District</label>
        <select asp-for="DistrictId" class="w-full rounded-xl border-slate-300">
            <option value="">Select district</option>
            @foreach (var district in districtOptions)
            {
                <option value="@district.Id">@district.Name (@district.Code)</option>
            }
        </select>
        <span asp-validation-for="DistrictId" class="text-xs text-rose-600"></span>
    </div>

    <div>
        <label asp-for="SubmissionChannel" class="block text-sm font-medium text-slate-700 mb-1">Submission Channel</label>
        <select asp-for="SubmissionChannel" class="w-full rounded-xl border-slate-300">
            <option value="">Select channel</option>
            @foreach (var channel in channels)
            {
                <option value="@channel">@channel</option>
            }
        </select>
        <span asp-validation-for="SubmissionChannel" class="text-xs text-rose-600"></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
            <label asp-for="DisasterType" class="block text-sm font-medium text-slate-700 mb-1">Disaster Type</label>
            <select asp-for="DisasterType" class="w-full rounded-xl border-slate-300" asp-items="Html.GetEnumSelectList<SAMVAD.DMS.Domain.Enums.DisasterType>()">
                <option value="">Select type</option>
            </select>
            <span asp-validation-for="DisasterType" class="text-xs text-rose-600"></span>
        </div>

        <div>
            <label asp-for="Priority" class="block text-sm font-medium text-slate-700 mb-1">Priority</label>
            <select asp-for="Priority" class="w-full rounded-xl border-slate-300" asp-items="Html.GetEnumSelectList<SAMVAD.DMS.Domain.Enums.IncidentPriority>()">
                <option value="">Select priority</option>
            </select>
            <span asp-validation-for="Priority" class="text-xs text-rose-600"></span>
        </div>
    </div>

    <div>
        <label asp-for="LocationText" class="block text-sm font-medium text-slate-700 mb-1">Location (Text)</label>
        <input asp-for="LocationText" class="w-full rounded-xl border-slate-300" placeholder="Area / landmark" />
        <span asp-validation-for="LocationText" class="text-xs text-rose-600"></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
            <label asp-for="LocationGpsLat" class="block text-sm font-medium text-slate-700 mb-1">Latitude</label>
            <input asp-for="LocationGpsLat" class="w-full rounded-xl border-slate-300" placeholder="Optional" />
            <span asp-validation-for="LocationGpsLat" class="text-xs text-rose-600"></span>
        </div>

        <div>
            <label asp-for="LocationGpsLng" class="block text-sm font-medium text-slate-700 mb-1">Longitude</label>
            <input asp-for="LocationGpsLng" class="w-full rounded-xl border-slate-300" placeholder="Optional" />
            <span asp-validation-for="LocationGpsLng" class="text-xs text-rose-600"></span>
        </div>
    </div>

    <div>
        <label asp-for="MobileNumber" class="block text-sm font-medium text-slate-700 mb-1">Citizen Mobile Number</label>
        <input asp-for="MobileNumber" class="w-full rounded-xl border-slate-300" placeholder="10-digit mobile" />
        <span asp-validation-for="MobileNumber" class="text-xs text-rose-600"></span>
    </div>

    <div>
        <label asp-for="Details" class="block text-sm font-medium text-slate-700 mb-1">Details</label>
        <textarea asp-for="Details" rows="3" class="w-full rounded-xl border-slate-300" placeholder="Additional details from the caller/reporter"></textarea>
        <span asp-validation-for="Details" class="text-xs text-rose-600"></span>
    </div>

    <div class="flex justify-end">
        <button type="button" id="submitOnBehalfBtn" class="rounded-lg bg-orange-600 text-white px-3 py-2 text-sm font-semibold">Submit Incident</button>
    </div>
</form>