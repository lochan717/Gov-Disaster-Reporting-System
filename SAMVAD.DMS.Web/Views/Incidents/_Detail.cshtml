@model SAMVAD.DMS.Application.DTOs.Incident.IncidentDetailDto

@if (Model is null)
{
    <p class="text-slate-500">Select an incident to view details.</p>
}
else
{
    @Html.AntiForgeryToken()
    <div class="space-y-2">
        <h2 class="text-lg font-bold">@Model.IncidentId</h2>
        <p class="text-sm text-slate-700">Type: @Model.DisasterType</p>
        <p class="text-sm text-slate-700">Status: @Model.Status</p>
        <p class="text-sm text-slate-700">Location: @Model.LocationText</p>

        <div class="pt-3 border-t border-slate-200 space-y-2">
            <h3 class="text-sm font-semibold text-slate-700">Attachments Bucket</h3>
            @if (!Model.MediaFiles.Any())
            {
                <p class="text-xs text-slate-500">No media attachments uploaded.</p>
            }
            else
            {
                <div class="grid grid-cols-1 gap-2">
                    @foreach (var media in Model.MediaFiles)
                    {
                        var isImage = media.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
                        var viewUrl = Url.Action("DownloadMedia", "Incidents", new { incidentId = Model.Id, mediaId = media.Id, fileName = media.FileName, contentType = media.ContentType, download = false }) ?? "#";
                        var downloadUrl = Url.Action("DownloadMedia", "Incidents", new { incidentId = Model.Id, mediaId = media.Id, fileName = media.FileName, contentType = media.ContentType, download = true }) ?? "#";

                        <div class="rounded-xl border border-slate-200 p-3 bg-slate-50">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-xs font-semibold text-slate-800 truncate">@media.FileName</p>
                                    <p class="text-[11px] text-slate-500">@media.MediaType · @media.UploadedBy · @media.UploadedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <a class="text-xs font-semibold text-orange-700 hover:underline" href="@viewUrl" target="_blank" rel="noopener noreferrer">View</a>
                                    <a class="text-xs font-semibold text-slate-700 hover:underline" href="@downloadUrl">Download</a>
                                </div>
                            </div>

                            @if (isImage)
                            {
                                <img src="@viewUrl" alt="@media.FileName" class="mt-2 max-h-36 rounded-lg border border-slate-200 object-contain bg-white" />
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="pt-3 border-t border-slate-200 space-y-2">
            <label class="block text-sm font-semibold text-slate-700">Update Status</label>
            <select id="incidentStatusSelect" class="w-full rounded-xl border-slate-300">
                <option value="1">Open</option>
                <option value="2">In Progress</option>
                <option value="3">Closed</option>
            </select>
            <textarea id="incidentStatusNote" rows="3" class="w-full rounded-xl border-slate-300" placeholder="Note (required for Closed)"></textarea>
            <button type="button" class="rounded-lg bg-orange-600 text-white px-3 py-2 text-sm font-semibold" id="updateIncidentStatusBtn" data-incident-id="@Model.Id">Update</button>
        </div>

        <div class="pt-3 border-t border-slate-200 space-y-2">
            <label class="block text-sm font-semibold text-slate-700">Add Comment</label>
            <textarea id="incidentCommentBody" rows="3" class="w-full rounded-xl border-slate-300" placeholder="Write comment"></textarea>
            <button type="button" class="rounded-lg bg-slate-800 text-white px-3 py-2 text-sm font-semibold" id="addIncidentCommentBtn" data-incident-id="@Model.Id">Post Comment</button>
        </div>
    </div>
}