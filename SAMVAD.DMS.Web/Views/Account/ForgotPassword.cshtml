@model SAMVAD.DMS.Application.DTOs.Auth.ForgotPasswordRequestDto
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
        <h1 class="text-xl font-bold text-slate-900 mb-4">Forgot Password</h1>
        <form method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input asp-for="Email" class="w-full rounded-xl border-slate-300" placeholder="Email" />
            <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
            <button type="submit" class="w-full py-3 rounded-xl bg-orange-600 text-white font-bold">Send Reset Link</button>
        </form>
        <a asp-action="Login" class="inline-block mt-4 text-sm font-semibold text-orange-700">Back to Login</a>
    </div>
</div>