@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Access Denied";
}

<div class="min-h-screen flex items-center justify-center">
    <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center">
        <h1 class="text-2xl font-bold text-slate-900">Access Denied</h1>
        <p class="mt-2 text-slate-600">You do not have permission to access this page.</p>
        <a asp-controller="Account" asp-action="Login" class="inline-block mt-4 text-orange-700 font-semibold">Go to Login</a>
    </div>
</div>