@model SAMVAD.DMS.Application.DTOs.Auth.ResetPasswordRequestDto
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
        <h1 class="text-xl font-bold text-slate-900 mb-4">Reset Password</h1>
        <form method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div>
                <label class="block text-sm font-semibold text-slate-700">Email</label>
                <input value="@Model.Email" class="w-full rounded-xl border-slate-300 bg-slate-50" readonly />
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-sm font-semibold text-slate-700"></label>
                <input asp-for="NewPassword" id="newPassword" type="password" class="w-full rounded-xl border-slate-300" placeholder="New Password" />
                <p id="passwordStrength" class="mt-1 text-xs text-slate-500">Strength: -</p>
                <span asp-validation-for="NewPassword" class="text-red-600 text-xs"></span>
            </div>

            <input asp-for="ConfirmPassword" type="password" class="w-full rounded-xl border-slate-300" placeholder="Confirm Password" />
            <span asp-validation-for="ConfirmPassword" class="text-red-600 text-xs"></span>

            @if (!ViewData.ModelState.IsValid)
            {
                <p class="text-xs text-slate-600">If this link has expired, request a new reset link from the Forgot Password screen.</p>
            }

            <button type="submit" class="w-full py-3 rounded-xl bg-orange-600 text-white font-bold">Update Password</button>
        </form>

        <a asp-action="ForgotPassword" class="inline-block mt-4 text-sm font-semibold text-orange-700">Request new reset link</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const passwordInput = document.getElementById('newPassword');
            const strengthLabel = document.getElementById('passwordStrength');
            if (!passwordInput || !strengthLabel) {
                return;
            }

            passwordInput.addEventListener('input', function () {
                const value = passwordInput.value || '';
                let score = 0;

                if (value.length >= 8) score++;
                if (/[A-Z]/.test(value)) score++;
                if (/[a-z]/.test(value)) score++;
                if (/\d/.test(value)) score++;
                if (/[^A-Za-z0-9]/.test(value)) score++;

                const labels = ['Very Weak', 'Weak', 'Fair', 'Good', 'Strong'];
                const index = Math.max(0, Math.min(4, score - 1));
                const text = value.length === 0 ? '-' : labels[index];
                strengthLabel.textContent = 'Strength: ' + text;
            });
        })();
    </script>
}