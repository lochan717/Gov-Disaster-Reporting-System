@model SAMVAD.DMS.Shared.Models.PaginatedResult<SAMVAD.DMS.Application.DTOs.User.AdminListItemDto>

<div id="adminsListMeta" data-page="@Model.Page" data-page-size="@Model.PageSize" data-total-count="@Model.TotalCount" data-total-pages="@Model.TotalPages" data-has-previous="@Model.HasPreviousPage.ToString().ToLowerInvariant()" data-has-next="@Model.HasNextPage.ToString().ToLowerInvariant()"></div>

<div class="space-y-3 md:hidden">
@if (!Model.Items.Any())
{
    <article class="rounded-2xl border border-dashed border-slate-300 p-4 bg-slate-50 text-sm text-slate-500">No admins found for the selected filters.</article>
}
@foreach (var item in Model.Items)
{
    <article class="rounded-2xl border border-slate-200 p-4 bg-white shadow-sm">
        <div class="flex items-start justify-between gap-3">
            <div>
                <h3 class="text-sm font-semibold text-slate-900">@item.Name</h3>
                <p class="text-xs text-slate-500">@item.Email</p>
            </div>
            <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-semibold @(item.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600")">
                @(item.IsActive ? "Active" : "Inactive")
            </span>
        </div>

        <div class="mt-3 grid grid-cols-1 gap-2 text-xs text-slate-600">
            <p><span class="font-semibold text-slate-700">Role:</span> @item.RoleLabel</p>
            <div>
                <p class="font-semibold text-slate-700 mb-1">Assigned Districts</p>
                @if (item.AssignedDistricts.Any())
                {
                    <div class="flex flex-wrap gap-1">
                        @foreach (var district in item.AssignedDistricts)
                        {
                            <span class="inline-flex items-center rounded-full bg-orange-50 text-orange-700 px-2 py-0.5 text-[11px] font-semibold">@district</span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-slate-500">No districts assigned</p>
                }
            </div>
        </div>

        <div class="mt-4 flex items-center gap-3 text-xs font-semibold">
            <button type="button" class="text-orange-700 hover:underline admin-edit-btn" data-admin-id="@item.Id">Edit</button>
            <button type="button" class="text-slate-700 hover:underline admin-toggle-btn" data-admin-id="@item.Id">Toggle</button>
            <button type="button" class="text-slate-700 hover:underline admin-reset-btn" data-admin-id="@item.Id">Reset Password</button>
        </div>
    </article>
}
</div>

<div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left">
        <thead>
            <tr class="text-xs uppercase text-slate-500">
                <th class="py-2">Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Assigned Districts</th>
                <th>Status</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr class="border-t border-slate-100 text-sm text-slate-700 align-top">
                <td class="py-2">@item.Name</td>
                <td>@item.Email</td>
                <td>@item.RoleLabel</td>
                <td>
                    @if (item.AssignedDistricts.Any())
                    {
                        <div class="flex flex-wrap gap-1 max-w-md">
                            @foreach (var district in item.AssignedDistricts)
                            {
                                <span class="inline-flex items-center rounded-full bg-orange-50 text-orange-700 px-2 py-0.5 text-[11px] font-semibold">@district</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-slate-500 text-xs">No districts assigned</span>
                    }
                </td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td class="text-right space-x-2">
                    <button type="button" class="text-xs font-semibold text-orange-700 hover:underline admin-edit-btn" data-admin-id="@item.Id">Edit</button>
                    <button type="button" class="text-xs font-semibold text-slate-700 hover:underline admin-toggle-btn" data-admin-id="@item.Id">Toggle</button>
                    <button type="button" class="text-xs font-semibold text-slate-700 hover:underline admin-reset-btn" data-admin-id="@item.Id">Reset Password</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>