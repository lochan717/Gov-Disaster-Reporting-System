@model SAMVAD.DMS.Application.DTOs.User.ResetUserPasswordDto
@{
    var adminId = (ViewBag.AdminId as string) ?? string.Empty;
    var adminName = (ViewBag.AdminName as string) ?? "User";
    var adminEmail = (ViewBag.AdminEmail as string) ?? string.Empty;
}

<form id="adminResetPasswordForm" class="space-y-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-xs text-rose-600"></div>
    <input type="hidden" name="Id" value="@adminId" />

    <div class="rounded-xl border border-orange-200 bg-orange-50 p-3 text-xs text-orange-800">
        <p class="font-semibold">Reset Password For</p>
        <p>@adminName</p>
        <p class="text-orange-700">@adminEmail</p>
    </div>

    <div>
        <label asp-for="NewPassword" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="NewPassword" type="password" class="w-full rounded-xl border-slate-300" autocomplete="new-password" placeholder="Enter new password" />
        <span asp-validation-for="NewPassword" class="text-xs text-rose-600"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="ConfirmPassword" type="password" class="w-full rounded-xl border-slate-300" autocomplete="new-password" placeholder="Confirm new password" />
        <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-600"></span>
    </div>

    <div class="flex justify-end">
        <button type="button" id="confirmAdminResetPasswordBtn" class="rounded-lg bg-orange-600 text-white px-3 py-2 text-sm font-semibold">Reset Password</button>
    </div>
</form>